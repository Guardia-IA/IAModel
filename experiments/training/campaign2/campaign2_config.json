{
  "version": 2,
  "description": "Kanvis Campaign2 — ventanas, splits agrupados, entrenamiento paralelo en GPU",
  "data_roots": [],
  "_data_roots_comment": "Rutas a .../data_result. Override: preflight --data-root /path (repetible). Si vacío, preflight usa PATH_ROOTS de config.py del legacy si existe.",
  "class_maps_dir": "../campaign/class_maps",
  "robbery_class": 6,
  "single_user_only": false,
  "pose_source": "full",
  "temporal": {
    "window_seconds": 8.0,
    "target_hz": 12.0,
    "stride_seconds": 1.0,
    "seq_len": 96
  },
  "split": {
    "strategy": "stratified_group_hybrid",
    "ratios": {
      "train": 0.7,
      "val_dev": 0.1,
      "threshold_calib": 0.1,
      "frozen_test": 0.1
    },
    "seed": 42,
    "group_keys": ["video_source", "clip_name_prefix"],
    "embargo_seconds": 8.0,
    "min_robbery_per_eval_split": 5,
    "_comment": "Sprint 1: split básico por group_id=hash(clip folder); Sprint 2+ mejora staged/real"
  },
  "cache": {
    "enabled": true,
    "use_shm": true,
    "shm_basename": "kanvis_pose_12hz",
    "dtype": "float32",
    "build_parallel_shards": 0,
    "_comment": "build_parallel_shards>0 reparte clips en N workers CPU (futuro)"
  },
  "parallelism": {
    "max_parallel_jobs": 8,
    "vram_reserve_mb": 2048,
    "auto_tune_from_probe": true,
    "probe_batch_size": 64,
    "probe_seq_len": 96,
    "probe_feature_dim": 62,
    "oom_retry_halve_batch": true,
    "max_dataloader_workers_per_job": 4,
    "max_cpu_workers_total": 32,
    "cuda_device_index": 0
  },
  "phases": {
    "p0_baseline": { "enabled": true },
    "p1_train_v2": { "enabled": true }
  },
  "p1_train": {
    "max_windows_per_clip": 32,
    "min_valid_joint_ratio": 0.25,
    "val_threshold": 0.5,
    "early_stop_patience": 15
  },
  "p1_eval": {
    "eval_split": "val_dev",
    "threshold": 0.5,
    "batch_size": 64
  },
  "debug": {
    "max_clips": 50,
    "max_windows_per_clip": 8,
    "early_stop_patience": 2,
    "p1_job_matrix": [
      {
        "job_id": "dbg_tcn",
        "arch": "masked_tcn64",
        "epochs": 4,
        "batch_size": 16,
        "seeds": 1
      },
      {
        "job_id": "dbg_gru",
        "arch": "gru64_pooled",
        "epochs": 4,
        "batch_size": 16,
        "seeds": 1
      }
    ],
    "_comment": "preflight --debug --p1: 2 jobs paralelos, pocas épocas, ~50 clips"
  },
  "p0_incumbent": {
    "enabled": true,
    "eval_split": "val_dev",
    "modes": ["legacy_clip", "windows"],
    "single_user_variants": [false, true],
    "frozen_thresholds": { "41": 0.8, "48": 0.8 },
    "ensemble_rule": "and",
    "batch_size": 64,
    "models": [
      {
        "id": "41",
        "path": "",
        "_path_comment": "Ruta a modelo_41.pt (campaña octubre). Alternativa: export CAMPAIGN2_MODEL_41"
      },
      {
        "id": "48",
        "path": "",
        "_path_comment": "Ruta a modelo_48.pt. Alternativa: export CAMPAIGN2_MODEL_48"
      }
    ]
  },
  "seeds": [17, 42, 103],
  "phase": "sprint3_p1",
  "_phase_comment": "sprint3_p1 = entrenamiento train_v2 (ventanas). Usa preflight --p1 o --p1-smoke.",
  "sprint1_smoke_jobs": 0,
  "_sprint1_smoke_jobs_comment": "Pon 3 solo para probar el scheduler (--smoke-test). 0 = cola vacía (recomendado hasta Sprint 2).",
  "time_estimate": {
    "legacy_calibration_factor": 7.0,
    "_legacy_calibration_factor_comment": "Oct/2026: preflight ~57 min/celda vs ~6.9 h wall real en bin_full (20 modelos).",
    "p1_job_matrix": [
      {
        "job_id": "v2_tcn64_baseline",
        "arch": "masked_tcn64",
        "epochs": 100,
        "batch_size": 64,
        "seq_len": 96,
        "seeds": 3
      },
      {
        "job_id": "v2_gru64_pooled",
        "arch": "gru64_pooled",
        "epochs": 100,
        "batch_size": 64,
        "seq_len": 96,
        "seeds": 3
      }
    ]
  }
}
