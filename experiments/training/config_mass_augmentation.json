{
  "enabled": true,
  "include_identity": false,
  "use_all_recipes": true,
  "variants_per_clip": 15,
  "target_train_rows": 100000,
  "cap_at_target": false,
  "max_extra_variants_per_clip": 3,
  "hard_negative_category_boost": {
    "2": 2.5,
    "3": 2.0,
    "14": 2.5
  },
  "robbery_category_extra_variants": 2,
  "keep_all_robbery_in_train": true,
  "synthetic_gate_max_ratio": 2.0,
  "deploy_targets": {
    "f1_pct": 70.0,
    "recall_pct": 60.0,
    "fp_rate_pct": 0.01
  },
  "apply_to_splits": ["train"],
  "recipes": [
    {"name": "scale_up", "ops": [{"op": "scale", "pct": 108.0}]},
    {"name": "scale_down", "ops": [{"op": "scale", "pct": 92.0}]},
    {"name": "noise_light_1", "ops": [{"op": "noise", "sx": 0.0025, "sy": 0.0025}]},
    {"name": "noise_light_2", "ops": [{"op": "noise", "sx": 0.0035, "sy": 0.0035}]},
    {"name": "rotate_left", "ops": [{"op": "rotate", "deg": -7.0}]},
    {"name": "rotate_right", "ops": [{"op": "rotate", "deg": 7.0}]},
    {"name": "speed_fast", "ops": [{"op": "speed", "factor": 0.88}]},
    {"name": "speed_slow", "ops": [{"op": "speed", "factor": 1.12}]},
    {"name": "mirror", "ops": [{"op": "mirror"}]},
    {"name": "mirror_scale_up", "ops": [{"op": "mirror"}, {"op": "scale", "pct": 108.0}]},
    {"name": "mirror_scale_down", "ops": [{"op": "mirror"}, {"op": "scale", "pct": 92.0}]},
    {"name": "mirror_noise_1", "ops": [{"op": "mirror"}, {"op": "noise", "sx": 0.0025, "sy": 0.0025}]},
    {"name": "mirror_rotate_left", "ops": [{"op": "mirror"}, {"op": "rotate", "deg": -7.0}]},
    {"name": "mirror_rotate_right", "ops": [{"op": "mirror"}, {"op": "rotate", "deg": 7.0}]},
    {"name": "mirror_speed_fast", "ops": [{"op": "mirror"}, {"op": "speed", "factor": 0.88}]}
  ],
  "synthetic_eval": {
    "clips_per_category_pool": 40,
    "variants_per_clip": 8,
    "seed": 42,
    "non_robbery_categories": "all_except_robbery"
  },
  "_comment": "15 variantes fijas por clip en TRAIN (~clips×15 filas). cap_at_target=false no recorta aunque supere target_train_rows; si queda por debajo, reparte extras en categorías minoritarias hasta target."
}
